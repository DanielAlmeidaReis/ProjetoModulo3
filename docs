
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda da Semana</title>
    
    <!-- Tailwind CSS para Estilização -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- React & ReactDOM via CDN -->
    <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
    
    <!-- Babel para compilar JSX no navegador -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        /* Adicionando animações baseadas no Tailwind animate-in que tínhamos */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes zoomIn { from { transform: scale(0.95); } to { transform: scale(1); } }
        .animate-fade-in { animation: fadeIn 0.2s ease-out; }
        .animate-zoom-in { animation: zoomIn 0.2s ease-out; }
    </style>
</head>
<body class="bg-slate-50">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        // Dados Iniciais
        const initialEvents = [
          {
            id: 'e1',
            title: 'Palestra: Futuro do Low-Code',
            date: '2026-06-15',
            time: '19:00',
            location: 'Auditório Principal - Sede',
            description: 'Uma visão abrangente sobre como plataformas low-code estão mudando o desenvolvimento de software.',
            status: 'published'
          },
          {
            id: 'e2',
            title: 'Reunião de Planejamento Q3',
            date: '2026-06-20',
            time: '09:00',
            location: 'Sala de Reuniões A',
            description: 'Alinhamento estratégico para o terceiro trimestre com líderes de departamento.',
            status: 'draft'
          }
        ];

        const initialGuests = [
          { id: 'g1', eventId: 'e1', name: 'Ana Silva', email: 'ana.silva@exemplo.com', status: 'checked-in' },
          { id: 'g2', eventId: 'e1', name: 'Carlos Santos', email: 'carlos.s@exemplo.com', status: 'pending' },
          { id: 'g3', eventId: 'e1', name: 'Mariana Costa', email: 'mariana.c@exemplo.com', status: 'pending' },
          { id: 'g4', eventId: 'e2', name: 'Roberto Almeida', email: 'roberto@exemplo.com', status: 'pending' },
        ];

        // Funções para gerenciar persistência local (Salva os dados no computador)
        const getLocalData = (key, defaultData) => {
            const saved = localStorage.getItem(key);
            return saved ? JSON.parse(saved) : defaultData;
        };

        const generateId = () => Math.random().toString(36).substr(2, 9);

        // Componentes de Ícones (Substituindo a biblioteca externa para manter tudo em 1 arquivo)
        const IconBase = ({ size = 24, className = '', children }) => (
          <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}>
            {children}
          </svg>
        );

        const Calendar = (p) => <IconBase {...p}><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></IconBase>;
        const Users = (p) => <IconBase {...p}><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></IconBase>;
        const CheckCircle = (p) => <IconBase {...p}><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></IconBase>;
        const Plus = (p) => <IconBase {...p}><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></IconBase>;
        const Search = (p) => <IconBase {...p}><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></IconBase>;
        const LayoutDashboard = (p) => <IconBase {...p}><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></IconBase>;
        const X = (p) => <IconBase {...p}><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></IconBase>;
        const Clock = (p) => <IconBase {...p}><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></IconBase>;
        const MapPin = (p) => <IconBase {...p}><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></IconBase>;
        const ChevronRight = (p) => <IconBase {...p}><polyline points="9 18 15 12 9 6"></polyline></IconBase>;
        const Menu = (p) => <IconBase {...p}><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></IconBase>;
        const Trash2 = (p) => <IconBase {...p}><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></IconBase>;
        const Ban = (p) => <IconBase {...p}><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></IconBase>;
        const Settings = (p) => <IconBase {...p}><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></IconBase>;

        const Card = ({ children, className = '' }) => (
          <div className={`bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden ${className}`}>
            {children}
          </div>
        );

        const Button = ({ children, variant = 'primary', icon: Icon, className = '', ...props }) => {
          const baseStyle = "inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2";
          const variants = {
            primary: "bg-blue-600 text-white hover:bg-blue-700 focus:ring-blue-500",
            secondary: "bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 focus:ring-slate-500",
            danger: "bg-red-50 text-red-600 hover:bg-red-100 focus:ring-red-500",
            ghost: "bg-transparent text-slate-600 hover:bg-slate-100 focus:ring-slate-500"
          };

          return (
            <button className={`${baseStyle} ${variants[variant]} ${className}`} {...props}>
              {Icon && <Icon size={16} />}
              {children}
            </button>
          );
        };

        const Modal = ({ isOpen, onClose, title, children }) => {
          if (!isOpen) return null;
          return (
            <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
              <div className="bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden animate-fade-in animate-zoom-in">
                <div className="flex items-center justify-between p-4 border-b border-slate-100">
                  <h3 className="font-semibold text-lg">{title}</h3>
                  <button onClick={onClose} className="p-1 rounded-md text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
                    <X size={20} />
                  </button>
                </div>
                <div className="p-4">
                  {children}
                </div>
              </div>
            </div>
          );
        };

        const DashboardView = ({ events, guests }) => {
          const upcomingEvents = events.filter(e => new Date(e.date) >= new Date()).sort((a, b) => new Date(a.date) - new Date(b.date)).slice(0, 3);
          const totalGuests = guests.length;
          const checkedInGuests = guests.filter(g => g.status === 'checked-in').length;

          return (
            <div className="space-y-6 animate-fade-in">
              <h2 className="text-2xl font-bold text-slate-800">Visão Geral</h2>
              
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <Card className="p-6 border-l-4 border-l-blue-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm font-medium text-slate-500">Total de Eventos</p>
                      <p className="text-3xl font-bold text-slate-800 mt-1">{events.length}</p>
                    </div>
                    <div className="p-3 bg-blue-50 rounded-full text-blue-600">
                      <Calendar size={24} />
                    </div>
                  </div>
                </Card>
                
                <Card className="p-6 border-l-4 border-l-indigo-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm font-medium text-slate-500">Total de Convidados</p>
                      <p className="text-3xl font-bold text-slate-800 mt-1">{totalGuests}</p>
                    </div>
                    <div className="p-3 bg-indigo-50 rounded-full text-indigo-600">
                      <Users size={24} />
                    </div>
                  </div>
                </Card>
                
                <Card className="p-6 border-l-4 border-l-emerald-500">
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-sm font-medium text-slate-500">Taxa de Check-in</p>
                      <p className="text-3xl font-bold text-slate-800 mt-1">
                        {totalGuests > 0 ? Math.round((checkedInGuests / totalGuests) * 100) : 0}%
                      </p>
                    </div>
                    <div className="p-3 bg-emerald-50 rounded-full text-emerald-600">
                      <CheckCircle size={24} />
                    </div>
                  </div>
                </Card>
              </div>

              <div className="mt-8">
                <h3 className="text-lg font-semibold text-slate-800 mb-4">Próximos Eventos</h3>
                <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                  {upcomingEvents.length === 0 ? (
                    <p className="text-slate-500">Nenhum evento futuro programado.</p>
                  ) : (
                     upcomingEvents.map(event => (
                      <Card key={event.id} className="p-5 hover:shadow-md transition-shadow">
                        <div className="flex justify-between items-start mb-2">
                          <span className={`text-xs font-medium px-2 py-1 rounded-full ${
                            event.status === 'published' ? 'bg-emerald-100 text-emerald-700' : 
                            event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                            'bg-slate-100 text-slate-700'
                          }`}>
                            {event.status === 'published' ? 'Publicado' : 
                             event.status === 'cancelled' ? 'Cancelado' : 'Rascunho'}
                          </span>
                        </div>
                        <h4 className="font-semibold text-lg text-slate-800 line-clamp-1">{event.title}</h4>
                        <div className="mt-3 space-y-2 text-sm text-slate-600">
                          <div className="flex items-center gap-2">
                            <Calendar size={14} className="text-slate-400" />
                            <span>{new Date(event.date).toLocaleDateString('pt-BR')} às {event.time}</span>
                          </div>
                          <div className="flex items-center gap-2">
                            <MapPin size={14} className="text-slate-400" />
                            <span className="truncate">{event.location}</span>
                          </div>
                        </div>
                      </Card>
                    ))
                  )}
                </div>
              </div>
            </div>
          );
        };

        const EventsList = ({ events, onSelectEvent, onCreateEvent }) => {
          return (
            <div className="space-y-6 animate-fade-in">
              <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <h2 className="text-2xl font-bold text-slate-800">Meus Eventos</h2>
                <Button onClick={onCreateEvent} icon={Plus}>Novo Evento</Button>
              </div>

              <Card>
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-sm">
                    <thead className="bg-slate-50 text-slate-600 border-b border-slate-200">
                      <tr>
                        <th className="px-6 py-4 font-medium">Nome do Evento</th>
                        <th className="px-6 py-4 font-medium hidden md:table-cell">Data e Hora</th>
                        <th className="px-6 py-4 font-medium hidden lg:table-cell">Local</th>
                        <th className="px-6 py-4 font-medium">Status</th>
                        <th className="px-6 py-4 font-medium text-right">Ação</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100">
                      {events.map(event => (
                        <tr key={event.id} className="hover:bg-slate-50 transition-colors">
                          <td className="px-6 py-4 font-medium text-slate-800">{event.title}</td>
                          <td className="px-6 py-4 text-slate-600 hidden md:table-cell">
                            {new Date(event.date).toLocaleDateString('pt-BR')} <span className="text-slate-400 mx-1">•</span> {event.time}
                          </td>
                          <td className="px-6 py-4 text-slate-600 hidden lg:table-cell truncate max-w-[200px]">{event.location}</td>
                          <td className="px-6 py-4">
                             <span className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                              event.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 
                              event.status === 'cancelled' ? 'bg-red-100 text-red-800' :
                              'bg-slate-100 text-slate-800'
                            }`}>
                              {event.status === 'published' ? 'Ativo' : 
                               event.status === 'cancelled' ? 'Cancelado' : 'Rascunho'}
                            </span>
                          </td>
                          <td className="px-6 py-4 text-right">
                            <Button variant="ghost" onClick={() => onSelectEvent(event.id)} className="px-2 py-1">
                              Gerenciar <ChevronRight size={16} />
                            </Button>
                          </td>
                        </tr>
                      ))}
                      {events.length === 0 && (
                        <tr>
                          <td colSpan="5" className="px-6 py-8 text-center text-slate-500">
                            Nenhum evento encontrado. Crie seu primeiro evento!
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </Card>
            </div>
          );
        };

        const EventDetails = ({ event, guests, onBack, onUpdateEvent, onAddGuest, onToggleCheckIn, onDelete, onCancel }) => {
          const [activeTab, setActiveTab] = useState('overview');
          const [showAddGuest, setShowAddGuest] = useState(false);
          const [newGuest, setNewGuest] = useState({ name: '', email: '' });

          const eventGuests = guests.filter(g => g.eventId === event.id);
          const checkedInCount = eventGuests.filter(g => g.status === 'checked-in').length;

          const handleAddGuest = (e) => {
            e.preventDefault();
            if (newGuest.name && newGuest.email) {
              onAddGuest(event.id, newGuest);
              setNewGuest({ name: '', email: '' });
              setShowAddGuest(false);
            }
          };

          return (
            <div className="space-y-6 animate-fade-in">
              <div className="flex flex-col md:flex-row md:items-start justify-between gap-4">
                <div className="flex items-start gap-4">
                  <button onClick={onBack} className="p-2 mt-1 bg-slate-100 text-slate-600 rounded-full hover:bg-slate-200 transition-colors shrink-0">
                    <ChevronRight size={20} className="rotate-180" />
                  </button>
                  <div>
                    <div className="flex items-center gap-3 flex-wrap">
                      <h2 className="text-2xl font-bold text-slate-800">{event.title}</h2>
                      {event.status === 'cancelled' && (
                        <span className="px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Cancelado</span>
                      )}
                    </div>
                    <div className="flex items-center gap-3 text-sm text-slate-500 mt-1 flex-wrap">
                       <span className="flex items-center gap-1"><Calendar size={14}/> {new Date(event.date).toLocaleDateString('pt-BR')}</span>
                       <span className="flex items-center gap-1"><Clock size={14}/> {event.time}</span>
                       <span className="flex items-center gap-1"><MapPin size={14}/> {event.location}</span>
                    </div>
                  </div>
                </div>
                
                <div className="flex flex-wrap items-center gap-2 md:ml-auto">
                  {event.status !== 'cancelled' && (
                    <Button variant="secondary" onClick={onCancel} icon={Ban} className="text-orange-600 border-orange-200 hover:bg-orange-50 focus:ring-orange-500">
                      Cancelar
                    </Button>
                  )}
                  <Button variant="danger" onClick={onDelete} icon={Trash2}>
                    Excluir
                  </Button>
                </div>
              </div>

              <div className="flex border-b border-slate-200">
                <button 
                  className={`px-4 py-2 font-medium text-sm border-b-2 transition-colors ${activeTab === 'overview' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-700'}`}
                  onClick={() => setActiveTab('overview')}
                >
                  Visão Geral
                </button>
                <button 
                  className={`px-4 py-2 font-medium text-sm border-b-2 transition-colors ${activeTab === 'guests' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-700'}`}
                  onClick={() => setActiveTab('guests')}
                >
                  Convidados & Check-in
                </button>
              </div>

              {activeTab === 'overview' && (
                <div className="grid md:grid-cols-3 gap-6 animate-fade-in">
                  <div className="md:col-span-2 space-y-6">
                    <Card className="p-6">
                      <h3 className="text-lg font-semibold mb-4">Detalhes do Evento</h3>
                      <p className="text-slate-600 whitespace-pre-wrap">{event.description || 'Sem descrição.'}</p>
                    </Card>
                  </div>
                  <div className="space-y-6">
                    <Card className="p-6 bg-slate-50">
                      <h3 className="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">Status Rápido</h3>
                      <div className="space-y-4">
                        <div>
                          <p className="text-2xl font-bold text-slate-800">{eventGuests.length}</p>
                          <p className="text-sm text-slate-500">Inscritos Totais</p>
                        </div>
                        <div>
                          <p className="text-2xl font-bold text-emerald-600">{checkedInCount}</p>
                          <p className="text-sm text-slate-500">Check-ins Realizados</p>
                        </div>
                        <div className="w-full bg-slate-200 rounded-full h-2 mt-2">
                          <div className="bg-emerald-500 h-2 rounded-full transition-all duration-500" style={{ width: `${eventGuests.length > 0 ? (checkedInCount/eventGuests.length)*100 : 0}%` }}></div>
                        </div>
                      </div>
                    </Card>
                  </div>
                </div>
              )}

              {activeTab === 'guests' && (
                <Card className="overflow-hidden animate-fade-in">
                  <div className="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                    <h3 className="font-semibold text-slate-800">Lista de Convidados</h3>
                    <Button size="sm" onClick={() => setShowAddGuest(true)} icon={Plus}>Adicionar Convidado</Button>
                  </div>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-sm">
                      <thead className="bg-white text-slate-500 border-b border-slate-200">
                        <tr>
                          <th className="px-6 py-3 font-medium">Nome</th>
                          <th className="px-6 py-3 font-medium">E-mail</th>
                          <th className="px-6 py-3 font-medium">Status</th>
                          <th className="px-6 py-3 font-medium text-right">Check-in</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100">
                        {eventGuests.map(guest => (
                          <tr key={guest.id} className={guest.status === 'checked-in' ? 'bg-emerald-50/50' : ''}>
                            <td className="px-6 py-4 font-medium text-slate-800">{guest.name}</td>
                            <td className="px-6 py-4 text-slate-600">{guest.email}</td>
                            <td className="px-6 py-4">
                              {guest.status === 'checked-in' ? (
                                <span className="inline-flex items-center gap-1 text-emerald-600 text-xs font-medium px-2 py-1 bg-emerald-100 rounded-full">
                                  <CheckCircle size={12} /> Presente
                                </span>
                              ) : (
                                <span className="text-slate-500 text-xs font-medium px-2 py-1 bg-slate-100 rounded-full">Pendente</span>
                              )}
                            </td>
                            <td className="px-6 py-4 text-right">
                              <button 
                                onClick={() => onToggleCheckIn(guest.id)}
                                className={`px-3 py-1.5 rounded-md text-xs font-medium transition-colors border ${
                                  guest.status === 'checked-in' 
                                  ? 'bg-white border-slate-300 text-slate-600 hover:bg-slate-50' 
                                  : 'bg-emerald-600 border-emerald-600 text-white hover:bg-emerald-700'
                                }`}
                              >
                                {guest.status === 'checked-in' ? 'Desfazer' : 'Fazer Check-in'}
                              </button>
                            </td>
                          </tr>
                        ))}
                        {eventGuests.length === 0 && (
                          <tr>
                            <td colSpan="4" className="px-6 py-8 text-center text-slate-500">
                              Nenhum convidado adicionado ainda.
                            </td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </Card>
              )}

              {/* Add Guest Modal */}
              <Modal isOpen={showAddGuest} onClose={() => setShowAddGuest(false)} title="Adicionar Convidado">
                <form onSubmit={handleAddGuest} className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">Nome Completo</label>
                    <input 
                      type="text" 
                      required
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
                      value={newGuest.name}
                      onChange={e => setNewGuest({...newGuest, name: e.target.value})}
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">E-mail</label>
                    <input 
                      type="email" 
                      required
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
                      value={newGuest.email}
                      onChange={e => setNewGuest({...newGuest, email: e.target.value})}
                    />
                  </div>
                  <div className="flex justify-end gap-2 mt-6">
                    <Button type="button" variant="ghost" onClick={() => setShowAddGuest(false)}>Cancelar</Button>
                    <Button type="submit">Salvar Convidado</Button>
                  </div>
                </form>
              </Modal>
            </div>
          );
        };

        function EventApp() {
          const [currentView, setCurrentView] = useState('dashboard');
          const [selectedEventId, setSelectedEventId] = useState(null);
          const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);

          // Estado da Aplicação com persistência no LocalStorage
          const [events, setEvents] = useState(() => getLocalData('agenda_events', initialEvents));
          const [guests, setGuests] = useState(() => getLocalData('agenda_guests', initialGuests));

          // Efeitos para salvar automaticamente quando houver mudanças
          useEffect(() => {
            localStorage.setItem('agenda_events', JSON.stringify(events));
          }, [events]);

          useEffect(() => {
            localStorage.setItem('agenda_guests', JSON.stringify(guests));
          }, [guests]);

          // Estado dos Modais
          const [showEventModal, setShowEventModal] = useState(false);
          const [newEvent, setNewEvent] = useState({ title: '', date: '', time: '', location: '', description: '', status: 'published' });
          const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);
          const [eventToDelete, setEventToDelete] = useState(null);

          // Handlers
          const requestDeleteEvent = (id) => {
            setEventToDelete(id);
            setShowDeleteConfirm(true);
          };

          const confirmDelete = () => {
            setEvents(events.filter(e => e.id !== eventToDelete));
            setGuests(guests.filter(g => g.eventId !== eventToDelete));
            setShowDeleteConfirm(false);
            setEventToDelete(null);
            setCurrentView('events');
          };

          const handleCancelEvent = (id) => {
            setEvents(events.map(e => e.id === id ? { ...e, status: 'cancelled' } : e));
          };

          const handleCreateEvent = (e) => {
            e.preventDefault();
            const event = { ...newEvent, id: generateId() };
            setEvents([...events, event]);

            setShowEventModal(false);
            setNewEvent({ title: '', date: '', time: '', location: '', description: '', status: 'published' });
            
            setSelectedEventId(event.id);
            setCurrentView('event_details');
          };

          const handleToggleCheckIn = (guestId) => {
            setGuests(guests.map(g => {
              if (g.id === guestId) {
                return { ...g, status: g.status === 'checked-in' ? 'pending' : 'checked-in' };
              }
              return g;
            }));
          };

          const handleAddGuest = (eventId, guestData) => {
            const guest = { ...guestData, id: generateId(), eventId, status: 'pending' };
            setGuests([...guests, guest]);
          };

          const navigateTo = (view) => {
            setCurrentView(view);
            setIsMobileMenuOpen(false);
          };

          const selectedEvent = events.find(e => e.id === selectedEventId);

          return (
            <div className="min-h-screen bg-slate-50 flex font-sans text-slate-900">
              
              {/* Sidebar - Desktop */}
              <aside className="hidden md:flex w-64 flex-col bg-slate-900 text-slate-300 shrink-0">
                <div className="p-6 flex items-center gap-2 text-white font-bold text-xl">
                  <div className="bg-blue-500 p-1.5 rounded-lg">
                    <Calendar size={20} className="text-white" />
                  </div>
                  Agenda da semana
                </div>
                <nav className="flex-1 px-4 space-y-2 mt-4">
                  <button 
                    onClick={() => navigateTo('dashboard')}
                    className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors ${currentView === 'dashboard' ? 'bg-blue-600 text-white' : 'hover:bg-slate-800 hover:text-white'}`}
                  >
                    <LayoutDashboard size={18} /> Dashboard
                  </button>
                  <button 
                    onClick={() => navigateTo('events')}
                    className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors ${['events', 'event_details'].includes(currentView) ? 'bg-blue-600 text-white' : 'hover:bg-slate-800 hover:text-white'}`}
                  >
                    <Calendar size={18} /> Meus Eventos
                  </button>
                  <button className="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors hover:bg-slate-800 hover:text-white opacity-50 cursor-not-allowed" title="Em breve">
                    <Users size={18} /> Contatos Globais
                  </button>
                  <button className="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors hover:bg-slate-800 hover:text-white opacity-50 cursor-not-allowed" title="Em breve">
                    <Settings size={18} /> Configurações
                  </button>
                </nav>
                <div className="p-4 border-t border-slate-800">
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-sm font-medium text-white">
                      US
                    </div>
                    <div className="text-sm">
                      <p className="text-white font-medium">Usuário Local</p>
                      <p className="text-xs text-slate-500">Dados salvos no PC</p>
                    </div>
                  </div>
                </div>
              </aside>

              {/* Mobile Header & Menu */}
              <div className="md:hidden fixed top-0 left-0 right-0 h-16 bg-slate-900 flex items-center justify-between px-4 z-40">
                <div className="flex items-center gap-2 text-white font-bold text-lg">
                  <div className="bg-blue-500 p-1.5 rounded-lg">
                    <Calendar size={18} className="text-white" />
                  </div>
                  Agenda da semana
                </div>
                <button onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)} className="text-slate-300 p-2">
                  {isMobileMenuOpen ? <X size={24} /> : <Menu size={24} />}
                </button>
              </div>

              {isMobileMenuOpen && (
                <div className="md:hidden fixed inset-0 top-16 bg-slate-900 z-30 p-4">
                   <nav className="space-y-2 text-slate-300">
                    <button 
                      onClick={() => navigateTo('dashboard')}
                      className={`w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-colors ${currentView === 'dashboard' ? 'bg-blue-600 text-white' : 'active:bg-slate-800'}`}
                    >
                      <LayoutDashboard size={20} /> Dashboard
                    </button>
                    <button 
                      onClick={() => navigateTo('events')}
                      className={`w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-colors ${['events', 'event_details'].includes(currentView) ? 'bg-blue-600 text-white' : 'active:bg-slate-800'}`}
                    >
                      <Calendar size={20} /> Meus Eventos
                    </button>
                  </nav>
                </div>
              )}

              {/* Main Content Area */}
              <main className="flex-1 flex flex-col min-w-0 md:pt-0 pt-16 h-screen overflow-hidden relative">
                
                {/* Top Header - Desktop */}
                <header className="hidden md:flex h-16 bg-white border-b border-slate-200 items-center justify-between px-8 shrink-0">
                  <div className="relative w-64">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={16} />
                    <input 
                      type="text" 
                      placeholder="Buscar..." 
                      className="w-full pl-9 pr-4 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    />
                  </div>
                  <div className="flex items-center gap-4">
                    <span className="text-xs bg-emerald-100 text-emerald-800 px-2 py-1 rounded-full font-medium flex items-center gap-1">
                       <CheckCircle size={12}/> Auto-salvamento ativo
                    </span>
                  </div>
                </header>

                {/* Scrollable Content */}
                <div className="flex-1 overflow-auto p-4 md:p-8">
                  <div className="max-w-6xl mx-auto">
                    {currentView === 'dashboard' && (
                      <DashboardView events={events} guests={guests} />
                    )}
                    
                    {currentView === 'events' && (
                      <EventsList 
                        events={events} 
                        onSelectEvent={(id) => { setSelectedEventId(id); setCurrentView('event_details'); }}
                        onCreateEvent={() => setShowEventModal(true)}
                      />
                    )}

                    {currentView === 'event_details' && selectedEvent && (
                      <EventDetails 
                        event={selectedEvent}
                        guests={guests}
                        onBack={() => setCurrentView('events')}
                        onToggleCheckIn={handleToggleCheckIn}
                        onAddGuest={handleAddGuest}
                        onDelete={() => requestDeleteEvent(selectedEvent.id)}
                        onCancel={() => handleCancelEvent(selectedEvent.id)}
                      />
                    )}
                  </div>
                </div>
              </main>

              {/* Create Event Modal */}
              <Modal isOpen={showEventModal} onClose={() => setShowEventModal(false)} title="Criar Novo Evento">
                <form onSubmit={handleCreateEvent} className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">Título do Evento *</label>
                    <input 
                      type="text" 
                      required
                      placeholder="Ex: Workshop de Design"
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                      value={newEvent.title}
                      onChange={e => setNewEvent({...newEvent, title: e.target.value})}
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-4">
                    <div>
                      <label className="block text-sm font-medium text-slate-700 mb-1">Data *</label>
                      <input 
                        type="date" 
                        required
                        className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                        value={newEvent.date}
                        onChange={e => setNewEvent({...newEvent, date: e.target.value})}
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-slate-700 mb-1">Hora *</label>
                      <input 
                        type="time" 
                        required
                        className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                        value={newEvent.time}
                        onChange={e => setNewEvent({...newEvent, time: e.target.value})}
                      />
                    </div>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">Local / Link</label>
                    <input 
                      type="text" 
                      placeholder="Ex: Auditório ou Link do Meet"
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"
                      value={newEvent.location}
                      onChange={e => setNewEvent({...newEvent, location: e.target.value})}
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-700 mb-1">Descrição</label>
                    <textarea 
                      rows={3}
                      placeholder="Detalhes sobre o evento..."
                      className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none resize-none"
                      value={newEvent.description}
                      onChange={e => setNewEvent({...newEvent, description: e.target.value})}
                    />
                  </div>
                  <div className="flex justify-end gap-2 mt-6 pt-4 border-t border-slate-100">
                    <Button type="button" variant="ghost" onClick={() => setShowEventModal(false)}>Cancelar</Button>
                    <Button type="submit">Criar Evento</Button>
                  </div>
                </form>
              </Modal>

              {/* Delete Confirmation Modal */}
              <Modal isOpen={showDeleteConfirm} onClose={() => setShowDeleteConfirm(false)} title="Excluir Evento">
                <div className="space-y-4">
                  <p className="text-slate-600">
                    Tem certeza que deseja excluir este evento? Esta ação não pode ser desfeita e removerá todos os convidados associados a ele.
                  </p>
                  <div className="flex justify-end gap-2 mt-6">
                    <Button variant="ghost" onClick={() => setShowDeleteConfirm(false)}>Voltar</Button>
                    <Button variant="danger" onClick={confirmDelete}>Sim, Excluir</Button>
                  </div>
                </div>
              </Modal>
            </div>
          );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<EventApp />);
    </script>
</body>
</html>
